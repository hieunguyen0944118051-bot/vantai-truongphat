// Tạo và hiển thị Slider
IJSlider.create = function (images, pLink, pTitle) {
    if (images == undefined || images.length <= 0) {
        Common.alert(LanguageManager.getText("LABEL", "LABLE_NODATA"));
        return;
    }
    // Thiết lập field name mặc định
    if (pLink == null || pLink === "") pLink = "img_link";
    if (pTitle == null || pTitle === "") pTitle = "title";
    // Kiểm tra xem là element khởi đầu của slider có hay chưa
    var gallery = $('#gallery_camera');
    if (gallery.length === 0) {
        var divfalso = $('<div id="falso" style="display: none; visibility: hidden">');
        divfalso.appendTo($("body"));

        gallery = $("<ul id='gallery_camera' class='gallery clearfix'>");
        gallery.appendTo(divfalso);
    }

    // Xóa các item con
    gallery.children().remove();

    // Khởi tạo các item ảnh
    $.each(images, function (index, cmr) {
        gallery.append("<li><a href='" + cmr[pLink] + "' rel='prettyPhoto[gallery2]' title='" + cmr[pTitle] + "'><img src='" + cmr[pLink] + "' width='60' height='60' alt='' /></a></li>");
    });

    // 
    gallery.find("a[rel^='prettyPhoto']").prettyPhoto();
    gallery.find("li:first a").click();
};

function setCookie(cname, cvalue, exmillisecond) {
    var d = new Date();
    d.setTime(d.getTime() + (exmillisecond));
    var expires = "expires=" + d.toUTCString();

    if (location.protocol !== "https:") {
        document.cookie = cname + "=" + cvalue + "; " + expires + ";";
    }
    else {
        document.cookie = cname + "=" + cvalue + "; " + expires + ";secure";
    }
}

function getCookie(cname) {
    var name = cname + "=";
    var ca = document.cookie.split(';');
    for (var i = 0; i < ca.length; i++) {
        var c = ca[i];
        while (c.charAt(0) === ' ') {
            c = c.substring(1);
        }
        if (c.indexOf(name) === 0) {
            return c.substring(name.length, c.length);
        }
    }
    return "";
}

