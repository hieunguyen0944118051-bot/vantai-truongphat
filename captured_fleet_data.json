// Thực hiện hiển thị modal custom lại của Bootstrap để có thể set được độ rộng của  modal
Common.modal = function (selector, width, height) {
    // hiển thị khi ko cần set width
    if (width == null) return $(selector).modal();

    height = height == null ? "auto" : height + "px";

    // 
    return $(selector).modal().css({ 'width': width + 'px', 'height': height, 'margin-left': 'auto', 'margin-right': 'auto', 'left': ($(window).width() - width) / 2 });
};

Common.alert = function (message) {
    alert(message);
}

