function UserBehaviorEntity() {
    //User ID - Guid
    this.UserId = null;
    //Hệ thống - int
    this.SystemType = 0;
    //Tên đăng nhập - string
    this.Username = '';
    //Tên đầy đủ - string
    this.Fullname = '';
    //Truyền menukey bảng menu vào coi như action vào trang , các action khác có thể thêm _Add , _Update , _Search ... - string
    this.ActionCode = '';
    //Tên đầy đủ của action code ghép cho nó dễ - string
    this.ActionName = '';
    //Mã XN lẻ - string
    this.CustomerCode = '';
    //Mã XN thường - int
    this.XNCode = 0;
    //Thời gian bắt đầu trên trang - DateTime
    this.StartTime = new Date().getTime() * 10000 + 621355968000000000;
    //Thời gian kết thúc trên trang - DateTime
    this.EndTime = new Date().getTime() * 10000 + 621355968000000000;
    //ID công ty - int
    this.CompanyId = 0;
    //Url
    this.Url = '';
}

function UserBehaviorManager(opts) {
    //Kiểm tra xem có đang thực hiện gửi dữ liệu trên trang ko
    this.sendingOnpageData = false;
    //Đối tượng mặc định, vì các trường hầu hết là mặc định
    this.defaultEntity = opts != null && opts.defaultEntity != null ? opts.defaultEntity : new UserBehaviorEntity();
    //Tên item trong local storage
    this.localDataName = opts != null && opts.localDataName != null ? opts.localDataName : 'localDataUserBehavior';
    //Lần cuối gửi để ko mất
    this.lastTime = opts != null && opts.lastTime != null ? opts.lastTime : new Date().getTime() * 10000 + 621355968000000000;

    var that = this;
    //Interval phụ trách gửi thông tin đăng nhập
    that.sendLoginInterval = setInterval(function () { that.sendLoginAction(); }, 5000);
    //Gọi luôn hàm gửi thông tin đăng nhập
    that.sendLoginAction();

    //2s cập nhật dữ liệu 1 lần
    setInterval(function () {
        if (!that.sendingOnpageData) that.logOnPageAction();
    }, 2000);

    //1 phút gửi dữ liệu đi 1 lần
    setInterval(function () {
        if (!that.sendingOnpageData) {
            that.sendingOnpageData = true;
            that.sendOnPageAction();
            that.sendingOnpageData = false;
        }
    }, 60000);

    //Gửi dữ liệu cũ đi nếu có
    that.sendingOnpageData = true;
    that.sendOnPageAction();
    that.sendingOnpageData = false;
}

//Hàm log sự kiện login qua được trang đăng nhập
UserBehaviorManager.prototype.sendLoginAction = function () {
    var that = this;
    $.ajax({
        type: "GET",
        url: URL_ROOT + "HttpHandlers/VideoCamHandler.ashx",//Sonnl_2021.08.17
        timeout: 15000,
        data: { 'method': 'UbLogs' },
        dataType: "json",
        success: function (result) {
            if (result.isFinished && that.sendLoginInterval != null) clearInterval(that.sendLoginInterval);
        },
        error: function () {
        }
    });
}

//Hàm log sự kiện trên trang
UserBehaviorManager.prototype.logOnPageAction = function () {
    var that = this;
    var now = new Date().getTime() * 10000 + 621355968000000000;
    var localData = localStorage.getItem(that.localDataName);
    if (localData == null) localData = [];
    else localData = JSON.parse(localData);

    //Tìm xem có item ứng với key đó trong localStorage ko
    var item = localData.find(x =>
        x.SystemType === that.defaultEntity.SystemType
        && x.UserId === that.defaultEntity.UserId
        && x.ActionCode === that.defaultEntity.ActionCode);

    //Nếu ko có clone 1 cái từ item mặc định
    if (item == null) {
        item = JSON.parse(JSON.stringify(that.defaultEntity));
        localData.push(item);
    }
    //Nếu có rồi chỉ cập nhật lại EndTime
    else {
        item.EndTime = that.lastTime = new Date().getTime() * 10000 + 621355968000000000;
    }
    localStorage.setItem(that.localDataName, JSON.stringify(localData));
}

//Hàm gửi sự kiện trên trang
UserBehaviorManager.prototype.sendOnPageAction = function () {
    var that = this;
    var localData = localStorage.getItem(that.localDataName);
    if (localData == null) localData = [];
    else localData = JSON.parse(localData);

    if (localData.length > 0) {
        $.ajax({
            type: "POST",
            url: URL_ROOT + "HttpHandlers/VideoCamHandler.ashx",//Sonnl_2021.08.17
            data: { method: 'OnPageLogs', datas: JSON.stringify(localData) },
            dataType: "json",
            timeout: 15000,
            success: function (rs) {
                if (rs.isSuccess) {
                    that.defaultEntity.StartTime = that.defaultEntity.EndTime = that.lastTime;
                    localStorage.setItem(that.localDataName, JSON.stringify([]));
                    that.logOnPageAction();
                }
                else {

                }
            },
            error: function () {
                that.sendingOnpageData = false;
            }
        });
    }
}
