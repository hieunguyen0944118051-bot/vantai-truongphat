//Khởi tạo ham
CamAlertManager.prototype.init = function () {
    var that = this;
    if (!this.hasAlert) return;
    //Lay ds xe 
    var rs = that.getListVehicleLite();

    if (rs != null && rs.length > 0) {
        for (var i = 0; i < rs.length; i++) {
            var ve = rs[i];
            if (!ve.lock && ve.mid != 128) that.listVehicle.put(ve.plate, ve);
        }
    }
    else {
        //Chẳng may không lấy được thì đợi 10s sau chạy lại xem sao
        setTimeout(function () {
            that.init();
        }, 10000);
        return;
    }

    if (this.isPush) {
        that.initPushAlert();
    }
    else {
        setInterval(function () {
            that.syncRequestAlerts();
        }, 15000);
    }
    //that.syncRequestAlerts();
}

CamAlertManager.prototype.registryListenSignalR = function () {
    var that = this;
    if (!that.isSupported || !that.validConnected) return;

    that.connection.on("PushAlertToUsers", (alert) => {
        that.drawPushAlertV2(alert);
    });
}

//Vẽ khung cảnh báo - Push - V2 - Thêm các cảnh báo khoảng cách an toàn và số người trên xe
//Sonnl 2021.09.20 created
CamAlertManager.prototype.drawPushAlertV2 = function (alert) {
    var that = this;
    if (alert == null || alert == '') return;
    alert = JSON.parse(alert);
    if (alert.WarningType != 74) return;
    if (alert.Url == null || alert.Url == '') return;
    if (!that.hasAlert) return;

    var vehicle = that.listVehicle.get(alert.VehiclePlate);
    if (vehicle == null) return;

    var addAlert = false;

    that.lastTime = new Date(alert.TimeStart);

    //Kiểm tra xem lưới đã có header chưa
    var hasHeader = that.divAlertNoMask.find('table .safeInfosHeader').length > 0;
    var html = '';

    //nếu chưa có header thì thêm vào
    if (!hasHeader) {
        var alertTypeCount = 0;
        var ww = 175;
        if (that.mask) {
            alertTypeCount += 1;
            ww += 70;
        }

        if (that.distance) {
            alertTypeCount += 1;
            ww += 70;
        }

        if (that.number) {
            alertTypeCount += 1;
            ww += 70;
        }
        that.divAlertNoMask.css('width', ww + 'px');

        html = '<tr class="safeInfosHeader">';
        html += '<td style="width:80px;">' + LanguageManager.getText('ONLINE', 'ONLINE_BKS').toUpperCase() + '</td>';
        html += '<td  style="width:80px;">' + LanguageManager.getText('REPORTS', 'TIMEPOINT').toUpperCase() + '</td>';
        html += '<td class="cellmask"  style="width:70px;">' + LanguageManager.getText('SAFETY_INFOS', 'MASK').toUpperCase() + '</td>';
        html += '<td class="celldistance" style="width:70px;">' + LanguageManager.getText('SAFETY_INFOS', 'DISTANCE').toUpperCase() + '</td>';
        html += '<td class="cellnumber" style="width:70px;">' + LanguageManager.getText('SAFETY_INFOS', 'NUMBER').toUpperCase() + '</td>';
        html += '</tr>';
        html += '<tr class="safeInfosHeader2"><td></td><td></td><td class="cellmask"></td><td class="celldistance"></td><td class="cellnumber"></td></tr>';
        html += '<tr class="safeInfosHeader3"><td>&nbsp;<br/><br/></td><td></td><td><td class="cellmask"></td><td class="celldistance"></td><td class="cellnumber"></td></tr>';
        that.divAlertNoMask.find('table').append(html);
        html = '';
    }

    //Kiểm tra xem lưới đã có header chưa
    var hasFooter = that.divAlertNoMask.find('.safeInfosFooter').length > 0;
    //nếu chưa có header thì thêm vào
    if (!hasFooter) {
        html = '<div class="safeInfosFooter">';
        html += '<div style="width:23px;height:23px;background:#77DB48;float:left;border-radius:50%;margin-left:20px;"></div><div style="float:left;">' + LanguageManager.getText('SAFETY_INFOS', 'SAFE') + '</div>';
        html += '<div style="width:23px;height:23px;background:#FF8078;float:left;border-radius:50%;margin-left:50px;"></div><div style="float:left;">' + LanguageManager.getText('SAFETY_INFOS', 'NOTSAFE') + '</div>';
        html += '</div>';
        that.divAlertNoMask.append(html);
        html = '';
    }

    var row1 = '<tr class="trAlertMask trAlertMask-' + alert.VehiclePlate + '">';
    var row2 = '<tr class="trAlertMask trAlertMask-' + alert.VehiclePlate + '">';
    //BKS
    row1 += '<td rowspan="2">' + alert.VehiclePlate + '</td>';
    //Thời điểm
    row1 += '<td rowspan="2" style="white-space: nowrap;">' + that.dateTimeFormatHHmmddMMyyyy(new Date(alert.TimeStart), '<br/>') + '</td>';

    //KHẨU TRANG - Người có người không 
    if (alert.CountUserUseMask > 0 && alert.CountUserNotMask > 0) {
        row1 += '<td class="cssUnsafe cellmask" style="border-bottom: 0;">' + alert.CountUserNotMask + '</td>';
        row2 += '<td class="cssSafe cellmask" style="border-top: 0;">' + alert.CountUserUseMask + '</td>';
        if (that.mask) addAlert = true;
    }
    //Tất cả có
    else if (alert.CountUserUseMask > 0) row1 += '<td rowspan="2" class="cssSafe cellmask">' + alert.CountUserUseMask + '</td>';
    //Tất cả không
    else {
        row1 += '<td rowspan="2" class="cssUnsafe cellmask">' + alert.CountUserNotMask + '</td>';
        if (that.mask) addAlert = true;
    }

    //KHOẢNG CÁCH - Tất cả có
    if (alert.DistanceViolationCount == 0) row1 += '<td rowspan="2" class="cssSafe celldistance">' + alert.PersonCount + '</td>';
    //Tất cả không 
    else if (alert.DistanceViolationCount == alert.PersonCount) {
        row1 += '<td rowspan="2" class="cssUnsafe celldistance">' + alert.PersonCount + '</td>';
        if (that.distance) addAlert = true;
    }
    //Người có người không
    else {
        row1 += '<td class="cssUnsafe celldistance" style="border-bottom: 0;">' + alert.DistanceViolationCount + '</td>';
        row2 += '<td class="cssSafe celldistance" style="border-top: 0;">' + (alert.PersonCount - alert.DistanceViolationCount) + '</td>';
        if (that.distance) addAlert = true;
    }

    //TỔNG SỐ NGƯỜI
    if (vehicle.seat == 0) {
        alert.PersonPercents = 0;
        alert.PersonCountStr = alert.PersonCount + "(/0)";
        alert.OverPeople = 0;
        row1 += '<td class="cssSafe cellnumber" style="border-bottom: 0;">' + alert.PersonCountStr + '</td>';
        row2 += '<td class="cssSafe cellnumber" style="border-top: 0;">(0%)</td>';
    }
    else {
        alert.PersonPercents = Math.ceil(alert.PersonCount * 100.0 / vehicle.seat);
        alert.PersonCountStr = alert.PersonCount + "/" + vehicle.seat;
        alert.OverPeople = alert.PersonCount - Math.floor(vehicle.seat * that.percents / 100.0);
        if (alert.OverPeople < 0) alert.OverPeople = 0;

        if (alert.OverPeople > 0) {
            row1 += '<td class="cssUnsafe cellnumber" style="border-bottom: 0;">' + alert.PersonCountStr + '</td>';
            row2 += '<td class="cssUnsafe cellnumber" style="border-top: 0;">(' + alert.PersonPercents + '%)</td>';
            if (that.number) addAlert = true;
        }
        else {
            row1 += '<td class="cssSafe cellnumber" style="border-bottom: 0;">' + alert.PersonCountStr + '</td>';
            row2 += '<td class="cssSafe cellnumber" style="border-top: 0;">(' + alert.PersonPercents + '%)</td>';
        }
    }

    row1 += '</tr>';
    row2 += '</tr>';

    if (addAlert) {
        //Xóa cảnh báo cũ hơn của mấy thằng mới này đi
        $('.trAlertMask-' + alert.VehiclePlate).remove();
        html += row1;
        html += row2;

        that.divAlertNoMask.find('table .safeInfosHeader2').after(html);
        if (!that.mask) $('.cellmask').remove();
        if (!that.distance) $('.celldistance').remove();
        if (!that.number) $('.cellnumber').remove();
        that.divAlertNoMask.parent().parent().show();
        that.showImagePush(alert);
    }
}

CamAlertManager.prototype.showImagePush = function (alert) {
    var that = this;
    $('.trAlertMask-' + alert.VehiclePlate).unbind('click');
    $('.trAlertMask-' + alert.VehiclePlate).click(function () {
        $('#detailAlertNoMaskND10 .plate').html(alert.VehiclePlate);
        $('#detailAlertNoMaskND10 .time').html(that.dateTimeFormatHHmmddMMyyyy(new Date(alert.TimeStart), ' '));
        $('#detailAlertNoMaskND10 .address').html(getAddressByLatLng(alert.Latitude, alert.Longitude));

        var h = 120;

        if (that.mask) {
            $('#detailAlertNoMaskND10 .mask').html(alert.CountUserUseMask);
            $('#detailAlertNoMaskND10 .noMask').html(alert.CountUserNotMask);

            if (alert.CountUserNotMask > 0) {
                $('#detailAlertNoMaskND10 .noMask').parent().css('color', '#CD1705');
                $('#detailAlertNoMaskND10 .noMask').parent().prev().css('color', '#CD1705');
            }
            else {
                $('#detailAlertNoMaskND10 .noMask').parent().css('color', '#0A8000');
                $('#detailAlertNoMaskND10 .noMask').parent().prev().css('color', '#0A8000');
            }
            $('#detailAlertNoMaskND10 .mask').parent().parent().show();
            h += 20;
        }
        else $('#detailAlertNoMaskND10 .mask').parent().parent().hide();

        if (that.distance) {
            $('#detailAlertNoMaskND10 .safeDistance').html(alert.PersonCount - alert.DistanceViolationCount);
            $('#detailAlertNoMaskND10 .unsafeDistance').html(alert.DistanceViolationCount);
            if (alert.DistanceViolationCount > 0) {
                $('#detailAlertNoMaskND10 .unsafeDistance').parent().css('color', '#CD1705');
                $('#detailAlertNoMaskND10 .unsafeDistance').parent().prev().css('color', '#CD1705');
            }
            else {
                $('#detailAlertNoMaskND10 .unsafeDistance').parent().css('color', '#0A8000');
                $('#detailAlertNoMaskND10 .unsafeDistance').parent().prev().css('color', '#0A8000');
            }
            $('#detailAlertNoMaskND10 .safeDistance').parent().parent().show();
            h += 20;
        }
        else $('#detailAlertNoMaskND10 .safeDistance').parent().parent().hide();



        if (that.number) {
            $('#detailAlertNoMaskND10 .overpeople').html(alert.OverPeople);
            $('#detailAlertNoMaskND10 .totalpeople').html(alert.PersonCountStr);
            if (alert.OverPeople > 0) {
                $('#detailAlertNoMaskND10 .overpeople').parent().css('color', '#CD1705');
                $('#detailAlertNoMaskND10 .overpeople').parent().prev().css('color', '#CD1705');
            }
            else {
                $('#detailAlertNoMaskND10 .overpeople').parent().css('color', '#0A8000');
                $('#detailAlertNoMaskND10 .overpeople').parent().prev().css('color', '#0A8000');
            }
            $('#detailAlertNoMaskND10 .totalpeople').parent().parent().show();
            h += 20;
        }
        else $('#detailAlertNoMaskND10 .totalpeople').parent().parent().hide();

        //Đối tượng Image js thuần
        var img = new Image;
        //Hàm thực hiện khi ảnh được load xong
        img.onload = function () {
            //Đối tượng canvas
            var ctx = $('#detailAlertNoMaskND10 .imageCanvas')[0];
            //Xóa canvas cũ đi
            ctx.getContext("2d").clearRect(0, 0, ctx.width, ctx.height);
            //Định nghĩa dài rộng bằng dài rộng của ảnh mới
            ctx.width = img.width;
            ctx.height = img.height;
            ctx = ctx.getContext("2d");
            //Show form chi tiết cảnh báo
            that.frmdetailAlertNoMaskND10.show(img.width + 40, img.height + h, function () { });

            //Vẽ ảnh gốc
            ctx.drawImage(img, 0, 0);
            //Vẽ danh sách có đeo
            if (alert.ListMask != null && alert.ListMask.length > 0 && alert.ListMask.length % 4 == 0) {
                for (var i = 0; i < alert.ListMask.length; i = i + 4) {
                    ctx.beginPath();
                    ctx.lineWidth = that.lineWidth;
                    ctx.strokeStyle = that.colorMask;
                    ctx.rect(alert.ListMask[i], alert.ListMask[i + 1], alert.ListMask[i + 2], alert.ListMask[i + 3]);
                    ctx.stroke();
                }
            }

            //Vẽ danh sách không đeo
            if (alert.ListNoMask != null && alert.ListNoMask.length > 0 && alert.ListNoMask.length % 4 == 0) {
                for (var i = 0; i < alert.ListNoMask.length; i = i + 4) {
                    ctx.beginPath();
                    ctx.lineWidth = that.lineWidth;
                    ctx.strokeStyle = that.colorNoMask;
                    ctx.rect(alert.ListNoMask[i], alert.ListNoMask[i + 1], alert.ListNoMask[i + 2], alert.ListNoMask[i + 3]);
                    ctx.stroke();
                }
            }

            if (alert.DistanceViolation != null && alert.DistanceViolation.length > 0 && alert.DistanceViolation.length % 4 == 0) {
                for (var i = 0; i < alert.DistanceViolation.length; i = i + 4) {
                    ctx.beginPath();
                    ctx.lineWidth = that.lineWidth;
                    ctx.strokeStyle = that.colorDistance;
                    ctx.rect(alert.DistanceViolation[i], alert.DistanceViolation[i + 1], alert.DistanceViolation[i + 2], alert.DistanceViolation[i + 3]);
                    ctx.stroke();
                }
            }
        };
        //Bắt đầu load ảnh vào đối tượng Image js
        img.src = alert.Url;
    })
}

//Khởi tạo cơ chế request cảnh báo
CamAlertManager.prototype.syncRequestAlerts = function () {
    var that = this;
    //lay du lieu tu api pnc
    var data = that.getRequestDataAlerts();
    //Neu co du lieu ve lai khung canh bao
    if (data != null && data.length > 0)
        //Ve anh canh bao
        that.drawRequestAlertsV2(data);
}
//Vẽ khung cảnh báo - V2 - thêm cảnh báo khoảng cách an toàn và đếm số người trên xe
//Sonnl 2021.09.20 created
CamAlertManager.prototype.drawRequestAlertsV2 = function (data) {
    var that = this;
    if (data == null || data.length == 0) return;
    data = data.sort(function (a, b) { return new Date(b.CaptureTime).getTime() - new Date(a.CaptureTime).getTime() });
    //Lần lấy dữ liệu cuối
    that.lastTime = new Date(data[0].CaptureTime);

    //Kiểm tra xem lưới đã có header chưa
    var hasHeader = that.divAlertNoMask.find('table .safeInfosHeader').length > 0;
    var html = '';

    //nếu chưa có header thì thêm vào
    if (!hasHeader) {
        var alertTypeCount = 0;
        var ww = 175;
        if (that.mask) {
            alertTypeCount += 1;
            ww += 70;
        }

        if (that.distance) {
            alertTypeCount += 1;
            ww += 70;
        }

        if (that.number) {
            alertTypeCount += 1;
            ww += 70;
        }

        that.divAlertNoMask.css('width', ww + 'px');

        html = '<tr class="safeInfosHeader">';
        html += '<td style="width:80px;">' + LanguageManager.getText('ONLINE', 'ONLINE_BKS').toUpperCase() + '</td>';
        html += '<td  style="width:80px;">' + LanguageManager.getText('REPORTS', 'TIMEPOINT').toUpperCase() + '</td>';
        html += '<td class="cellmask"  style="width:70px;">' + LanguageManager.getText('SAFETY_INFOS', 'MASK').toUpperCase() + '</td>';
        html += '<td class="celldistance" style="width:70px;">' + LanguageManager.getText('SAFETY_INFOS', 'DISTANCE').toUpperCase() + '</td>';
        html += '<td class="cellnumber" style="width:70px;">' + LanguageManager.getText('SAFETY_INFOS', 'NUMBER').toUpperCase() + '</td>';
        html += '</tr>';
        html += '<tr class="safeInfosHeader2"><td></td><td></td><td class="cellmask"></td><td class="celldistance"></td><td class="cellnumber"></td></tr>';
        html += '<tr class="safeInfosHeader3"><td>&nbsp;<br/><br/></td><td></td><td><td class="cellmask"></td><td class="celldistance"></td><td class="cellnumber"></td></tr>';
        that.divAlertNoMask.find('table').append(html);
        html = '';
    }

    //Kiểm tra xem lưới đã có header chưa
    var hasFooter = that.divAlertNoMask.find('.safeInfosFooter').length > 0;
    //nếu chưa có header thì thêm vào
    if (!hasFooter) {
        html = '<div class="safeInfosFooter">';
        html += '<div style="width:23px;height:23px;background:#77DB48;float:left;border-radius:50%;margin-left:20px;"></div><div style="float:left;">' + LanguageManager.getText('SAFETY_INFOS', 'SAFE') + '</div>';
        html += '<div style="width:23px;height:23px;background:#FF8078;float:left;border-radius:50%;margin-left:50px;"></div><div style="float:left;">' + LanguageManager.getText('SAFETY_INFOS', 'NOTSAFE') + '</div>';
        html += '</div>';
        that.divAlertNoMask.append(html);
        html = '';
    }

    for (var i = 0; i < data.length; i++) {
        var item = data[i];

        //Xóa cảnh báo cũ hơn của mấy thằng mới này đi
        $('.trAlertMask-' + data[i].VehiclePlate).remove();

        var row1 = '<tr class="trAlertMask trAlertMask-' + item.VehiclePlate + '">';
        var row2 = '<tr class="trAlertMask trAlertMask-' + item.VehiclePlate + '">';
        //BKS
        row1 += '<td rowspan="2">' + item.VehiclePlate + '</td>';
        //Thời điểm
        row1 += '<td rowspan="2" style="white-space: nowrap;">' + that.dateTimeFormatHHmmddMMyyyy(new Date(item.CaptureTime), '<br/>') + '</td>';

        //KHẨU TRANG - Người có người không 
        if (item.TotalMask > 0 && item.TotalNoMask > 0) {
            row1 += '<td class="cssUnsafe cellmask" style="border-bottom: 0;">' + item.TotalNoMask + '</td>';
            row2 += '<td class="cssSafe cellmask" style="border-top: 0;">' + item.TotalMask + '</td>';
        }
        //Tất cả có
        else if (item.TotalMask > 0) row1 += '<td rowspan="2" class="cssSafe cellmask">' + item.TotalMask + '</td>';
        //Tất cả không
        else row1 += '<td rowspan="2" class="cssUnsafe cellmask">' + item.TotalNoMask + '</td>';

        //KHOẢNG CÁCH - Tất cả có
        if (item.DistanceViolationCount == 0) row1 += '<td rowspan="2" class="cssSafe celldistance">' + item.PersonCount + '</td>';
        //Tất cả không 
        else if (item.DistanceViolationCount == item.PersonCount) row1 += '<td rowspan="2" class="cssUnsafe celldistance">' + item.PersonCount + '</td>';
        //Người có người không
        else {
            row1 += '<td class="cssUnsafe celldistance" style="border-bottom: 0;">' + item.DistanceViolationCount + '</td>';
            row2 += '<td class="cssSafe celldistance" style="border-top: 0;">' + (item.PersonCount - item.DistanceViolationCount) + '</td>';
        }

        //TỔNG SỐ NGƯỜI
        if (item.OverPeople > 0) {
            row1 += '<td class="cssUnsafe cellnumber" style="border-bottom: 0;">' + item.PersonCountStr + '</td>';
            row2 += '<td class="cssUnsafe cellnumber" style="border-top: 0;">(' + item.PersonPercents + '%)</td>';
        }
        else {
            row1 += '<td class="cssSafe cellnumber" style="border-bottom: 0;">' + item.PersonCountStr + '</td>';
            row2 += '<td class="cssSafe cellnumber" style="border-top: 0;">(' + item.PersonPercents + '%)</td>';
        }

        row1 += '</tr>';
        row2 += '</tr>';

        html += row1;
        html += row2;
    }
    that.divAlertNoMask.find('table .safeInfosHeader2').after(html);
    if (!that.mask) $('.cellmask').remove();
    if (!that.distance) $('.celldistance').remove();
    if (!that.number) $('.cellnumber').remove();
    that.divAlertNoMask.parent().parent().show();

    for (var i = 0; i < data.length; i++) {
        var item = data[i];
        that.showImage(item);
    }
}

CamAlertManager.prototype.showImage = function (item) {
    var that = this;
    $('.trAlertMask-' + item.VehiclePlate).unbind('click');
    $('.trAlertMask-' + item.VehiclePlate).click(function () {
        $('#detailAlertNoMaskND10 .plate').html(item.VehiclePlate);
        $('#detailAlertNoMaskND10 .time').html(that.dateTimeFormatHHmmddMMyyyy(new Date(item.CaptureTime), ' '));
        $('#detailAlertNoMaskND10 .address').html(getAddressByLatLng(item.Latitude, item.Longitude));


        var h = 120;

        if (that.mask) {
            $('#detailAlertNoMaskND10 .mask').html(item.TotalMask);
            $('#detailAlertNoMaskND10 .noMask').html(item.TotalNoMask);
            if (item.TotalNoMask > 0) {
                $('#detailAlertNoMaskND10 .noMask').parent().css('color', '#CD1705');
                $('#detailAlertNoMaskND10 .noMask').parent().prev().css('color', '#CD1705');
            }
            else {
                $('#detailAlertNoMaskND10 .noMask').parent().css('color', '#0A8000');
                $('#detailAlertNoMaskND10 .noMask').parent().prev().css('color', '#0A8000');
            }
            $('#detailAlertNoMaskND10 .mask').parent().parent().show();
            h += 20;
        }
        else $('#detailAlertNoMaskND10 .mask').parent().parent().hide();

        if (that.distance) {
            $('#detailAlertNoMaskND10 .safeDistance').html(item.PersonCount - item.DistanceViolationCount);
            $('#detailAlertNoMaskND10 .unsafeDistance').html(item.DistanceViolationCount);
            if (item.DistanceViolationCount > 0) {
                $('#detailAlertNoMaskND10 .unsafeDistance').parent().css('color', '#CD1705');
                $('#detailAlertNoMaskND10 .unsafeDistance').parent().prev().css('color', '#CD1705');
            }
            else {
                $('#detailAlertNoMaskND10 .unsafeDistance').parent().css('color', '#0A8000');
                $('#detailAlertNoMaskND10 .unsafeDistance').parent().prev().css('color', '#0A8000');
            }
            $('#detailAlertNoMaskND10 .safeDistance').parent().parent().show();
            h += 20;
        }
        else $('#detailAlertNoMaskND10 .safeDistance').parent().parent().hide();

        if (that.number) {
            $('#detailAlertNoMaskND10 .overpeople').html(item.OverPeople);
            $('#detailAlertNoMaskND10 .totalpeople').html(item.PersonCountStr);
            if (item.OverPeople > 0) {
                $('#detailAlertNoMaskND10 .overpeople').parent().css('color', '#CD1705');
                $('#detailAlertNoMaskND10 .overpeople').parent().prev().css('color', '#CD1705');
            }
            else {
                $('#detailAlertNoMaskND10 .overpeople').parent().css('color', '#0A8000');
                $('#detailAlertNoMaskND10 .overpeople').parent().prev().css('color', '#0A8000');
            }
            $('#detailAlertNoMaskND10 .totalpeople').parent().parent().show();
            h += 20;
        }
        else $('#detailAlertNoMaskND10 .totalpeople').parent().parent().hide();



        that.frmdetailAlertNoMaskND10.show(item.Width + 40, item.Height + h, function () { });
        //Vẽ canvas
        var ctx = $('#detailAlertNoMaskND10 .imageCanvas')[0];
        ctx.getContext("2d").clearRect(0, 0, ctx.width, ctx.height);
        ctx.width = item.Width;
        ctx.height = item.Height;
        ctx = ctx.getContext("2d");

        var img = new Image;
        img.onload = function () {
            ctx.drawImage(img, 0, 0);
            if (item.CanvasMask != null && item.CanvasMask.length > 0 && item.CanvasMask.length % 4 == 0) {
                for (var i = 0; i < item.CanvasMask.length; i = i + 4) {
                    ctx.beginPath();
                    ctx.lineWidth = that.lineWidth;
                    ctx.strokeStyle = that.colorMask;
                    ctx.rect(item.CanvasMask[i], item.CanvasMask[i + 1], item.CanvasMask[i + 2], item.CanvasMask[i + 3]);
                    ctx.stroke();
                }
            }

            if (item.CanvasNoMask != null && item.CanvasNoMask.length > 0 && item.CanvasNoMask.length % 4 == 0) {
                for (var i = 0; i < item.CanvasNoMask.length; i = i + 4) {
                    ctx.beginPath();
                    ctx.lineWidth = that.lineWidth;
                    ctx.strokeStyle = that.colorNoMask;
                    ctx.rect(item.CanvasNoMask[i], item.CanvasNoMask[i + 1], item.CanvasNoMask[i + 2], item.CanvasNoMask[i + 3]);
                    ctx.stroke();
                }
            }

            if (item.DistanceViolation != null && item.DistanceViolation.length > 0 && item.DistanceViolation.length % 4 == 0) {
                for (var i = 0; i < item.DistanceViolation.length; i = i + 4) {
                    ctx.beginPath();
                    ctx.lineWidth = that.lineWidth;
                    ctx.strokeStyle = that.colorDistance;
                    ctx.rect(item.DistanceViolation[i], item.DistanceViolation[i + 1], item.DistanceViolation[i + 2], item.DistanceViolation[i + 3]);
                    ctx.stroke();
                }
            }
        };
        img.src = item.UrlImageRaw;
    })
}

