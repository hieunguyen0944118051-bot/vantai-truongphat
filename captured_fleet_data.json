/* 
* $Author$ sonnl 
* Hàm định kỳ request cảnh báo từ server
*/
CamAlertManager.prototype.getRequestDataAlerts = function () {
    var that = this;
    // Clear all old data;
    var rs = null;
    $.ajax({
        type: "POST",
        url: URL_ROOT + "HttpHandlers/VideoCamHandler.ashx",//Sonnl_2021.08.17
        async: false,
        data: { 'method': 'nd10ImageSync', 'plates': that.listVehicle.keys().join(), 'lastTime': that.dateTimeFormatyyyyMMddHHmmss(that.lastTime) },
        dataType: "json",
        success: function (result) {
            if (result.isSuccess) rs = result.data;
        },
        error: function () {
        }
    });
    return rs;
};
//#endregion

//Hàm kiểm tra có sử dụng tính năng cảnh báo camera ko
//Sonnl 2021.05.31 created
CamAlertManager.prototype.getConfigBaCamAlert = function () {
    var that = this;
    var hasAlert = false;
    $.ajax({
        type: "GET",
        url: URL_ROOT + "HttpHandlers/VideoCamHandler.ashx",//Sonnl_2021.08.17
        timeout: 15000,
        async: false,
        data: { 'method': 'getConfigBaCamAlert' },
        dataType: "json",
        success: function (result) {
            if (result.isSuccess) {
                that.userID = result.userID;
                hasAlert = result.hasAlertMask;
                that.percents = result.percents;
                that.mask = result.mask;
                that.distance = result.distance;
                that.number = result.number;
            }
        },
        error: function () {
        }
    });
    return hasAlert;
}

/* 
* $Author$		sonnl lite
* Lay ra danh sach xe theo user - copy từ online sang
*/
CamAlertManager.prototype.getListVehicleLite = function () {
    var begin = new Date();
    var that = this;
    // Clear all old data;
    var listVehicle = [];
    if (that.lockUI) {
        $.lockUserInterface();
    }
    $.ajax({
        type: "POST",
        url: URL_ROOT + "HttpHandlers/OnlineHandler.ashx",
        async: false,
        cache: false,
        data: { 'method': 'initListVehicleLite' },
        dataType: "json",
        
        complete: function () {
            if (that.lockUI) {
                $.unlockUserInterface();
            }
        },
        success: function (result) {
            if (result.success) {
                var vehicles = result.data;
                if (vehicles != null && vehicles.length > 0) {
                    for (var i = 0; i < vehicles.length; i++) {
                        listVehicle.push(that.parseVehicleItem(JSON.parse(vehicles[i])[0]));
                    }
                }
            }
            var total = new Date() - begin;
            console.log("initListVehicleLite - total:" + total + " - processTime: " + result.processTime + " - network:" + (total - result.processTime));

        },
        error: function () {
            if (that.lockUI) {
                $.unlockUserInterface();
            }
        }
    });
    return listVehicle;
};

CamAlertManager.prototype.getValue = function (type, val) {
    var that = this;
    if (val == null) {
        return that.defaultVal[type];
    }
    return val;
};

CamAlertManager.prototype.parseVehicleItem = function (ir) {
    var that = this;
    var j;
    var item = {};
    for (j = 0; j < that.onlineViewDataType.length; j++) {
        if (that.onlineViewDataType[j][0] !== "object" || that.onlineViewDataType[j][0] !== "listObject") {
            item[that.onlineViewDataType[j][1]] = that.getValue(that.onlineViewDataType[j][0], ir["_" + (j + 1)]);
        } else {
            item[that.onlineViewDataType[j][1]] = ir["_" + (j + 1)];
        }
    }

    //Xu ly nhung thang la con
    if (item.bgt != null) {
        for (j = 0; j < that.bgt.length; j++) {
            item.bgt[that.bgt[j][1]] = that.getValue(that.bgt[j][0], item.bgt["_" + (j + 1)]);
        }
    }

    if (item.lst_fuel_up_down != null && item.lst_fuel_up_down.length > 0) {
        for (var i = 0; i < item.lst_fuel_up_down.length; i++) {
            for (j = 0; j < that.listUpDown.length; j++) {
                item.lst_fuel_up_down[that.listUpDown[j][1]] = that.getValue(that.listUpDown[j][0], item.lst_fuel_up_down["_" + (j + 1)]);
            }
        }
    }

    if (item.lhs != null && item.lhs.length > 0) {
        for (var i = 0; i < item.lhs.length; i++) {
            for (j = 0; j < that.lhs.length; j++) {
