$(function () {
    $("#txtFuncFind").autocomplete(
    {
        minLength: 3,
        source: function (request, response) {
            $.ajax({
                url: "/HttpHandlers/AutoCompleteHandler.ashx",
                dataType: "json",
                data:
                {
                    method: "searchFuncs",
                    maxRows: 12,
                    keyword: request.term
                },
                success: function (data) {
                    response(data.menu);
                }
            });
        },
        focus: function (event, ui) {
            $("#txtFuncFind").val(ui.item.Name);
            return false;
        },
        select: function (event, ui) {
            $("#txtFuncFind").val(ui.item.Name);
            location.href = ui.item.LinkAction;
            return false;
        }
    })
    .data("autocomplete")._renderItem = function (ul, item) {
        ul.css("max-height", "300px");
        return $("<li>").data("item.autocomplete", item).append("<img src='" + item.Icon + "' style='float:left; width:16px; height: 16px; margin-top:3px;margin-right:8px; margin-left:4px' /><a style='padding-left:28px'>" + item.Name + "</a>").appendTo(ul);
    };

    var isHover = false;
    var isFocus = false;
    $("#bar #search i").hover(
        function () {
            isHover = true;
            $("#bar #search input").animate({ width: "294px" }).focus();
        },
        function () {
            isHover = false;
            if (!isFocus) $("#bar #search input").animate({ width: "2px" });
        }
    );

    $("#bar #search input").focus(function () {
        isFocus = true;
        if (!isHover) $("#bar #search input").animate({ width: "294px" });
    });

    $("#bar #search input").blur(function () {
        isFocus = false;
        if (!isHover) $("#bar #search input").animate({ width: "2px" });
    });
});;
function FormBase()
{
    var $this = this;

    // phương thức dùng để thiết lập khi mà có class kế thừa đến
    this.setThis = function (that) 
    {
        $this = that;
    }

    // PopupModal selector
    this.selector = null;

    // 
    this.modal = null;

    // Cờ lưu là có phải là đang hiển thị Form hay không
    this.isShowing = false;

    // Sự kiện khi đóng Form
    this.closeForm = null;

    // Sự kiện sau khi mà form được hiển thị lên
    this.afterShow = null;

    // Khởi tạo Form
    this.init = function () 
    {
        // elemenent modal
        $this.modal = $($this.selector);

        // Sự kiện khi ẩn Form
        $this.modal.on('hide', function () 
        {
            $this.isShowing = false;

            // Nếu có sự kiện đóng Form
            $this.onClose();
        });

        // Sự kiện khi bật Form
        $this.modal.on('show', function () 
        {
            onAfterShow();
        });
    };

    // sự kiện đóng Form
    this.onClose = function () 
    {
        if ($this.closeForm != null) $this.closeForm();
    }

    // Ẩn Form
    this.hide = function()
    {
        $($this.selector).modal('hide');
    }

    // Thực hiện hiển thị Form
    this.show = function (width, height, func) 
    {
        // Nếu là đang hiển thị Form rồi thì thoát
        if ($this.isShowing) return;

        // Cờ thông báo là đang hiển thị Form
        $this.isShowing = true;

        // init form
        $this.init();

        // gán sự kiện afterShowExtend
        afterShowExtend = func;

        // Hiển thị Form
        Common.modal($this.selector, width, height);
    };

    // mở rộng cho sự kiện sau khi hiển thị Form
    var afterShowExtend = null;

    // Thực thi sự kiện sau khi hiển thị Form
    var onAfterShow = function () 
    {
        // Sự kiện sau khi hiển thị Form
        if ($this.afterShow != null) $this.afterShow();

        // Sự kiện sau khi hiển thị Form, được mở rộng khi người dùng gọi lệnh hiển thị Form
        if (afterShowExtend != null) afterShowExtend();
    };
};
