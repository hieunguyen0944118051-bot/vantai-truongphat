                if (o.selectAll)
                    html += "<table cellspacing='2' cellpadding='2' >";
                html += '<tr><td style="width:' + chieuRongtd + 'px;"><input type="checkbox" class="selectAll" /><label class="selectAll">' + o.selectAllText + '</label></td>';
                for (var j = 0; j < cot - 1; j++) {
                    html += "<td style='width: " + chieuRongtd + "px;'></td>";
