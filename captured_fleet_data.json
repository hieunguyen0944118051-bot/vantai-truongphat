var LanguageManager = (function () {
    var dicLang = null;
    var dicLangCommon = null;

    var self = {};

    var LANGUAGES = {
        'en-US': 'english',
        'lo-LA': 'laos',
        'default': 'vietnam'
    };

    function buildLanguagePath(folder, lang) {
        return '/languages/' + folder + '/' + lang + '.xml?v=' + self.resourceVersion();
    }

    function getLanguageName() {
        var culture = $.cookie('CultureInfo');
        return LANGUAGES[culture] || LANGUAGES['default'];
    }

    self.resourceVersion = function () {
        var version = $.cookie('ResourceVersion');
        return version != null ? version.toString() : new Date().toGMTString();
    };

    self.languageFolder = function () {
        var lf = $.cookie('LanguageFolder');
        return lf != null ? lf : "common";
    };

    self.setCulture = function () {
        dicLang = null;
        dicLangCommon = null;
    };

    function buildKey(page, tag) {
        return (page + '_' + tag).toLowerCase();
    }

    function parseXmlToDictionary(xml) {
        var dictionary = {};
        $(xml).find("page").each(function () {
            var page = $(this).attr('name');
            $(this).children().each(function () {
                var tag = this.attributes[0].value;
                var value = $(this).text();
                dictionary[buildKey(page, tag)] = value;
            });
        });
        return dictionary;
    }

    function loadAndCacheXml(url, storageKey, callback) {
        $.ajax({
            type: "GET",
            url: url,
            async: false,
            dataType: "xml",
            success: function (xml) {
                var dict = parseXmlToDictionary(xml);
                localStorage.setItem(storageKey + "_expired", new Date());
                localStorage.setItem(storageKey, LZString.compress(JSON.stringify(dict)));
                callback(dict);
            },
            error: function () {
                alert("Error loading XML file...");
            }
        });
    }

    self.loadData = function () {
        var langName = getLanguageName();
        var folder = self.languageFolder();
        var now = new Date();

        var filePath = buildLanguagePath(folder, langName);
        var filePathCommon = buildLanguagePath("common", langName);

        var simplePath = filePath.split('?')[0];
        var simplePathCommon = filePathCommon.split('?')[0];

        var expired = localStorage.getItem(simplePath + "_expired");
        var isExpired = expired && (now - Date.parse(expired) > 1800000);

        var isCommonLang = (folder === "common");

        if (!isExpired) {
            var cachedLang = localStorage.getItem(simplePath);
            var cachedCommon = isCommonLang ? cachedLang : localStorage.getItem(simplePathCommon);

            if (cachedLang && cachedCommon) {
                dicLang = JSON.parse(LZString.decompress(cachedLang));
                dicLangCommon = JSON.parse(LZString.decompress(cachedCommon));
                return;
            }
        }

        // Xóa cache nếu hết hạn hoặc không tồn tại
        localStorage.removeItem(simplePath);
        if (!isCommonLang) localStorage.removeItem(simplePathCommon);

        dicLang = null;
        dicLangCommon = null;

        // Load file chính (module)
        loadAndCacheXml(filePath, simplePath, function (dict) {
            dicLang = dict;
            if (isCommonLang) {
                dicLangCommon = dict; // Không cần load file common
            }
        });

        // Nếu ngôn ngữ không phải "common", load thêm file common
        if (!isCommonLang) {
            loadAndCacheXml(filePathCommon, simplePathCommon, function (dict) {
                dicLangCommon = dict;
            });
        }
    };

    self.getText = function (page, tag) {
        if (dicLang === null || dicLangCommon === null) {
            self.loadData();
        }

        var key = buildKey(page, tag);
        var text = dicLang[key];
        return (text == null || text === "") ? dicLangCommon[key] : text;
    };

    return self;
})();
;
