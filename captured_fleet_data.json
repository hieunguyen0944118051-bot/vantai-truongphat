function strVNremoveAccentAscii(theString) {
    theString = convertToVnWithoutDiacritic(theString);
    return theString.replace(/[^\x00-\xFF]/g, "");
}

function decimalLatToDergeeMinSe(lat) {
    var ns = "N";
    if (lat < 0) {
        lat = -lat;
        ns = "S";
    }

    d = parseInt(lat);  // Truncate the decimals
    t1 = (lat - d) * 60;
    m = parseInt(t1);
    s = ((t1 - m) * 60).toFixed(4);

    return d + "° " + ((m < 10 ? "0" + m : m) + "' ") + ((s < 10 ? "0" + s : s) + "'' " + ns);
}

function decimalLngToDergeeMinSe(lng) {
    var ew = "E";
    if (lng < 0) {
        lng = -lng;
        ew = "W";
    }

    d = parseInt(lng);  // Truncate the decimals
    t1 = (lng - d) * 60;
    m = parseInt(t1);
    s = ((t1 - m) * 60).toFixed(4);
    return d + "° " + ((m < 10 ? "0" + m : m) + "' ") + ((s < 10 ? "0" + s : s) + "'' " + ew);
}

function minuteToDHM(min, dayStr, hourStr, minStr, agoStr) {
    if (min <= 0) return '';
    min = parseInt(min);

    var hour = 0;
    var minute = 0;

    if (min > 60) {
        minute = min % 60;
        hour = (min - minute) / 60;
    }
    else
    {
        minute = min;
    }

    if (hour > 0) {
        return (hour + " " + hourStr + " " + (minute < 10 ? "0" + minute : minute) + " " + minStr + " " + agoStr).toLowerCase();
    }
    else {
        return (minute + " " + minStr + " " + agoStr).toLowerCase();
    }
}

function getParameterByName(name, url) {
    if (!url) url = window.location.href;
    name = name.replace(/[\[\]]/g, '\\$&');
    var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
        results = regex.exec(url);
    if (!results) return null;
    if (!results[2]) return '';
    return decodeURIComponent(results[2].replace(/\+/g, ' '));
}

function makeSessionID(length) {
    var result = '';
    var characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    var charactersLength = characters.length;
    for (var i = 0; i < length; i++) {
        result += characters.charAt(Math.floor(Math.random() *
            charactersLength));
    }

    if (result == '' || result.length < length) {
        return makeid(length);
    }
    return result;
}

function getTimeFromDt(dt) {
    var min = dt.getMinutes();
    if (min < 10) min = '0' + min;
    var hour = dt.getHours();
    if (hour < 10) hour = '0' + hour;
    return hour + ':' + min;
}

