                            html1 += '<input type="checkbox"  name="' + $(select).attr('name') + '"';
                            html1 += ' value="' + $(select)[0][i].value + '"';

                            var Ch = $(select)[0][i].defaultSelected;
                            if (Ch == true) html1 += ' checked="checked"';
                            html1 += ' />';

                            html1 += '<label>' + $(select)[0][i].text + '</label>';
                        }
                        html1 += "</td>";
                        if ((i + 1) % cot == 0 && i != Sobanghi && i > 0) {
                            html1 += "</tr>";
                        }
                    }
                    html1 += "</tr>";
                }

