                    dorongcuathediv = 'width:' + parseInt(parseInt(cot * 102) + 24) + 'px'; ;

                }
                else { //gan do rong bang width cua minh truyen vao.
                    dorongcuathetxt = 'width:' + o.controlWidth + 'px';
                    dorongcuathediv = 'width:' + parseInt(parseInt(cot * chieuRongtd)) + 'px'; ;
                }

                var html = '<input id="txtmultiSelect' + o.elementValue + '"  type="text" readonly="readonly" class="multiSelect" value="" style="cursor: default;' + dorongcuathetxt + ' " />';
