//////////////////////////////////
// ham tinh khoang cach giua 2 diem tren google map
// x: kinh do (Longitude)
// y: vi do (Latitude)
////////////////////////////////////
function canculator_dis(x1, y1, x2, y2) {
    if (x1 === x2 && y1 === y2) return 0;
    var p1X = x1 * (Math.PI / 180);
    var p1Y = y1 * (Math.PI / 180);
    var p2X = x2 * (Math.PI / 180);
    var p2Y = y2 * (Math.PI / 180);
    var kc;
    var temp;
    kc = p2X - p1X;
    temp = Math.cos(kc);
    temp = temp * Math.cos(p2Y);
    temp = temp * Math.cos(p1Y);
    kc = Math.sin(p1Y);
    kc = kc * Math.sin(p2Y);
    temp = temp + kc;
    kc = Math.acos(temp);
    kc = kc * 6378137;
    return kc;
};

function convertToVnWithoutDiacritic(str) {
    str = str.trim();
    str = str.toLowerCase();
    str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
    str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
    str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
    str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
    str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
    str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
    str = str.replace(/đ/g, "d");
    return str;
}


/////////////////////////////////////////////
// ham lay huong tren ban do google map, input: 2 diem
// x: kinh do (Longitude) 105.xxxxxx
// y: vi do (Latitude) 21.yyyyyy
////////////////////////////////////////////
function getdir(olddir, oldlongitude, oldlatitude, longitude, latitude) {

    //First point
    if (oldlatitude === 0 && oldlongitude === 0) {
        return 0;
    }

    //If longitude and latitude are not valid, don't change car's direction
    if (longitude === 0 | latitude === 0) { return olddir; }

    //Calculate new direction
    var g;

    var deltax = latitude - oldlatitude;
    var deltay = longitude - oldlongitude;

    var s = Math.sqrt(Math.pow(deltax, 2) + Math.pow(deltay, 2));
    g = Math.acos(deltax / s);

    if (deltay < 0) { g = 2 * Math.PI - g; }

    g = Math.round(4 * g / Math.PI);
    if (g > 7 || g < 0 || isNaN(g)) { g = 0; }

    if (isNaN(g)) {
        g = 0;
    }

    return g;
};

/* 
* $Author$		trungtq
* Lay ra dia chi theo vi do, kinh do
* @param  lat   Vi do
* @param  lng   Kinh do
*/
function getAddressByLatLng(lat, lng) {
    var address = '';
    $.ajax({
        type: "GET",
        url: URL_ROOT + "HttpHandlers/PointHandler.ashx",
        async: false,
        data: { 'method': 'getAddress', 'lat': lat, 'lng': lng },
        dataType: "json",
        success: function (result) {
            if (result.success) {
                address = result.data;
            }
        },
        error: function () {//err
        }
    });
    return address;
};

//Format ngày tháng định dạng yyyy-MM-dd HH:mm:ss
function dateTimeFormatyyyyMMddHHmmssExcelName(dt) {
    return dt.getFullYear() + '_' +
        (dt.getMonth() < 9 ? "0" + (dt.getMonth() + 1) : (dt.getMonth() + 1)) + '_' +
        (dt.getDate() < 10 ? "0" + dt.getDate() : dt.getDate()) + '_' +
        (dt.getHours() < 10 ? "0" + dt.getHours() : dt.getHours()) + '_' +
        (dt.getMinutes() < 10 ? "0" + dt.getMinutes() : dt.getMinutes()) + '_' +
        (dt.getSeconds() < 10 ? "0" + dt.getSeconds() : dt.getSeconds());
};

//Format ngày tháng định dạng yyyy-MM-dd HH:mm:ss
function dateTimeFormatyyyyMMddHHmmss(dt) {
    return dt.getFullYear() + '-' +
        (dt.getMonth() < 9 ? "0" + (dt.getMonth() + 1) : (dt.getMonth() + 1)) + '-' +
        (dt.getDate() < 10 ? "0" + dt.getDate() : dt.getDate()) + ' ' +
        (dt.getHours() < 10 ? "0" + dt.getHours() : dt.getHours()) + ':' +
        (dt.getMinutes() < 10 ? "0" + dt.getMinutes() : dt.getMinutes()) + ':' +
        (dt.getSeconds() < 10 ? "0" + dt.getSeconds() : dt.getSeconds());
};

//Format ngày tháng định dạng HH:mm:ss - ddd/MM/yyyy
function dateTimeFormatRouteHistoryOutSide(dt) {
    return (dt.getHours() < 10 ? "0" + dt.getHours() : dt.getHours()) + ":" +
        (dt.getMinutes() < 10 ? "0" + dt.getMinutes() : dt.getMinutes()) + ":" +
        (dt.getSeconds() < 10 ? "0" + dt.getSeconds() : dt.getSeconds()) + " - " +
        (dt.getDate() < 10 ? "0" + dt.getDate() : dt.getDate()) + "/" +
        (dt.getMonth() < 9 ? "0" + (dt.getMonth() + 1) : (dt.getMonth() + 1)) + "/" +
        dt.getFullYear();
};

//Format ngày tháng định dạng yyyy-MM-dd HH:mm:ss
function dateTimeFormatddMMyyyyHHmmWithSlash(dt) {
    return (dt.getDate() < 10 ? "0" + dt.getDate() : dt.getDate())
        + '/' + (dt.getMonth() < 9 ? "0" + (dt.getMonth() + 1) : (dt.getMonth() + 1))
        + '/' + dt.getFullYear()
        + ' ' + (dt.getHours() < 10 ? "0" + dt.getHours() : dt.getHours())
        + ':' + (dt.getMinutes() < 10 ? "0" + dt.getMinutes() : dt.getMinutes());
};


//Format ngày tháng định dạng yyyy-MM-dd
function dateTimeFormatyyyyMMdd(dt) {
    return dt.getFullYear() + '-' +
        (dt.getMonth() < 9 ? "0" + (dt.getMonth() + 1) : (dt.getMonth() + 1)) + '-' +
        (dt.getDate() < 10 ? "0" + dt.getDate() : dt.getDate());
};


function getCsrfToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]');
}

$.ajaxSetup({
    beforeSend: function (xhr) {
        var token = getCsrfToken()
        if (token) {
            xhr.setRequestHeader('X-CSRF-TOKEN', token.value);
